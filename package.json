    "rescue:airdrop": "tsx src/airdropRescue.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "rescue-tokens-from-compromised-wallet",
    "sweeper-bot-rescue",
    "flashbots-whitehat-rescue",
    "claim-airdrop-from-compromised-wallet",
    "eip-7702-atomic-rescue",
    "flashbots",
    "whitehat",
    "mev-dao",
    "ethereum"
  ],
  "homepage": "https://mevdao.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/mevdao-org/compromised-wallet-sweeper-rescue.git"
  },
