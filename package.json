{
  "name": "compromised-wallet-sweeper-rescue",
  "version": "1.3.0",
  "description": "Atomic Flashbots whitehat rescue toolkit to recover ERC-20 tokens, NFTs, staking positions, and unclaimed airdrops from compromised wallets monitored by sweeper bots. Maintained by MEV DAO (https://mevdao.org)",
